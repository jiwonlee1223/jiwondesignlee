---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { t } from '@/i18n/utils';
---

<BaseLayout title={`${t('about.heading')} — Jiwon Lee`}>
  <div class="site-container pt-16 pb-24">
    <div class="grid md:grid-cols-[1fr_340px] gap-16 items-start">

      <!-- ── 좌: 본문 ────────────────────────────────────────────────────── -->
      <div>
        <h1 class="font-display font-bold text-display-lg mb-12">
          {t('about.heading')}
        </h1>

        <div class="space-y-6 text-lg leading-relaxed max-w-2xl">
          <p>
            I'm <strong>Jiwon Lee</strong>, a PhD Candidate in
            <a href="https://id.kaist.ac.kr/" target="_blank" rel="noopener noreferrer"
               class="underline decoration-fg/30 hover:decoration-fg">
              Industrial Design at KAIST
            </a>.
            I research and build interactive systems that sit between people and AI —
            <em>conversational agents</em>, <em>storytelling interfaces</em>, and
            <em>design tools</em> that scaffold creative thought.
          </p>
          <p>
            Recurring concerns in my work: how AI-mediated encounters shape memory and
            anticipation (e.g., embodied future-self agents), how stories surface from
            mundane data (e.g., dashcam footage), and how grids and graphs let designers
            externalize tacit reasoning.
          </p>
          <p>
            Before KAIST, I studied Service &amp; Design Engineering at
            Sungshin Women's University. In 2024 my undergraduate thesis project was named
            a <strong>Korea National Winner</strong> of the James Dyson Award and
            reached the <strong>International Top 20</strong>.
          </p>
        </div>

        <!-- ── 학력 ────────────────────────────────────────────────── -->
        <h2 class="font-display font-semibold text-xl mt-14 mb-5">Education</h2>
        <ol class="space-y-4 text-sm font-mono" role="list">
          <li class="grid grid-cols-[120px_1fr] gap-4 items-start">
            <span class="text-fg-muted">2025 — present</span>
            <span>
              <strong>PhD Candidate, Industrial Design</strong><br />
              <span class="text-fg-muted">KAIST</span>
            </span>
          </li>
          <li class="grid grid-cols-[120px_1fr] gap-4 items-start">
            <span class="text-fg-muted">2023 — 2025</span>
            <span>
              <strong>MTech, Industrial Design</strong><br />
              <span class="text-fg-muted">KAIST</span>
            </span>
          </li>
          <li class="grid grid-cols-[120px_1fr] gap-4 items-start">
            <span class="text-fg-muted">2019 — 2023</span>
            <span>
              <strong>BE, Service &amp; Design Engineering</strong><br />
              <span class="text-fg-muted">Sungshin Women's University</span>
            </span>
          </li>
        </ol>

        <!-- ── 수상 ────────────────────────────────────────────────── -->
        <h2 class="font-display font-semibold text-xl mt-12 mb-5">Selected Awards</h2>
        <ul class="space-y-3 text-sm font-mono" role="list">
          <li class="grid grid-cols-[120px_1fr] gap-4 items-start">
            <span class="text-fg-muted">2024</span>
            <span>
              <a href="https://www.jamesdysonaward.org/en-US/2024/project/oxynizersustainablenon-electric-oxygen-generator"
                 target="_blank" rel="noopener noreferrer"
                 class="underline decoration-fg/30 hover:decoration-fg hover:text-accent-cobalt transition-colors">James Dyson Award ↗</a>
              · <strong>Korea National Winner</strong> · International Top 20
            </span>
          </li>
          <li class="grid grid-cols-[120px_1fr] gap-4 items-start">
            <span class="text-fg-muted">2024</span>
            <span>
              <a href="https://www.idsa.org/awards-recognition/idea/idea-gallery/oxynizer-sustainable-non-electric-oxygen-generator/"
                 target="_blank" rel="noopener noreferrer"
                 class="underline decoration-fg/30 hover:decoration-fg hover:text-accent-cobalt transition-colors">IDEA ↗</a>
              · <strong>Bronze</strong>
            </span>
          </li>
          <li class="grid grid-cols-[120px_1fr] gap-4 items-start">
            <span class="text-fg-muted">2024</span>
            <span>KAIST Q-Day · Creativity &amp; Talent Education Award</span>
          </li>
          <li class="grid grid-cols-[120px_1fr] gap-4 items-start">
            <span class="text-fg-muted">2021</span>
            <span>Human City Design Student Workshop · Academic Award</span>
          </li>
          <li class="grid grid-cols-[120px_1fr] gap-4 items-start">
            <span class="text-fg-muted">—</span>
            <span>Sungshin WAIKWITH Entrepreneurship Competition · Grand Prize</span>
          </li>
        </ul>

        <!-- ── 전시 ────────────────────────────────────────────────── -->
        <h2 class="font-display font-semibold text-xl mt-12 mb-5">Exhibitions</h2>
        <ul class="space-y-3 text-sm font-mono" role="list">
          <li class="grid grid-cols-[120px_1fr] gap-4 items-start">
            <span class="text-fg-muted">2024.11</span>
            <span>
              <a href="https://prototypesforhumanity.com/prototypes/oxynizer"
                 target="_blank" rel="noopener noreferrer"
                 class="underline decoration-fg/30 hover:decoration-fg hover:text-accent-cobalt transition-colors">
                Prototypes for Humanity ↗
              </a>
              · Jumeirah Emirates Towers, Dubai
              <span class="text-fg-muted">· Art Dubai Group</span>
            </span>
          </li>
          <li class="grid grid-cols-[120px_1fr] gap-4 items-start">
            <span class="text-fg-muted">2024.12</span>
            <span>
              <strong class="font-normal">Crossing Over: Innovation and Boundaries</strong>
              · Ground Seoul
              <span class="text-fg-muted">· ID KAIST</span>
              · <a href="https://www.chosun.com/national/weekend/2024/12/28/SZNHZH3N6FHL3LCNRSB4V5LHVU/"
                   target="_blank" rel="noopener noreferrer"
                   class="text-fg-muted underline decoration-fg/30 hover:decoration-fg hover:text-accent-cobalt transition-colors">Press ↗</a>
            </span>
          </li>
          <li class="grid grid-cols-[120px_1fr] gap-4 items-start">
            <span class="text-fg-muted">2025.12</span>
            <span>
              <strong class="font-normal">In Transition: Programmable Design</strong>
              · 노들갤러리 1관
              <span class="text-fg-muted">· ID KAIST</span>
              · <a href="https://biz.heraldcorp.com/article/10633442"
                   target="_blank" rel="noopener noreferrer"
                   class="text-fg-muted underline decoration-fg/30 hover:decoration-fg hover:text-accent-cobalt transition-colors">Press ↗</a>
            </span>
          </li>
          <li class="grid grid-cols-[120px_1fr] gap-4 items-start">
            <span class="text-fg-muted">2026.04</span>
            <span>
              <a href="https://webzine.nrf.re.kr/magazine/2603/sub7.php"
                 target="_blank" rel="noopener noreferrer"
                 class="underline decoration-fg/30 hover:decoration-fg hover:text-accent-cobalt transition-colors">
                대한민국 과학축제 in 경기 ↗
              </a>
              · KINTEX
              <span class="text-fg-muted">· 과학기술정보통신부</span>
            </span>
          </li>
        </ul>

        <!-- ── CV 다운로드 (CV 완성 전까지 일시 비활성화) ──────────────── -->
        <span
          class="inline-flex items-center gap-2 mt-12 px-5 py-3
                 bg-fg/10 text-fg-muted font-mono text-sm cursor-not-allowed select-none"
          aria-disabled="true"
          title="CV is coming soon"
        >
          {t('about.cv')} · Coming soon
        </span>

        <!-- CV 완성되면 위 span을 지우고 아래 주석을 풀어 다시 활성화:
        <a
          href="/cv.pdf"
          class="inline-flex items-center gap-2 mt-12 px-5 py-3
                 bg-fg text-bg font-mono text-sm
                 hover:bg-accent-cobalt transition-colors duration-200"
          download
        >
          {t('about.cv')} ↓
        </a>
        -->

      </div>

      <!-- ── 우: 사진 + 연락처 ──────────────────────────────────────────── -->
      <aside class="space-y-8 md:sticky md:top-20">
        <img
          src="/profile.jpg"
          alt="Jiwon Lee"
          class="aspect-square w-full object-cover border border-fg/10"
          loading="lazy"
        />

        <div class="space-y-3 font-mono text-sm">
          <div>
            <p class="text-xs text-fg-muted uppercase tracking-wider mb-1">
              {t('about.email')}
            </p>
            <a
              href="mailto:jiwonlee1223@kaist.ac.kr"
              class="hover:text-accent-cobalt transition-colors break-all"
            >
              jiwonlee1223@kaist.ac.kr
            </a>
          </div>

          <div>
            <p class="text-xs text-fg-muted uppercase tracking-wider mb-1">
              Links
            </p>
            <ul class="space-y-1" role="list">
              <li>
                <a
                  href="https://www.linkedin.com/in/jiwondesignlee"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="hover:text-accent-cobalt transition-colors"
                >
                  LinkedIn ↗
                </a>
              </li>
              <li>
                <a
                  href="https://scholar.google.com"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="hover:text-accent-cobalt transition-colors"
                >
                  Google Scholar ↗
                </a>
              </li>
            </ul>
          </div>
        </div>
      </aside>

    </div>
  </div>
</BaseLayout>
