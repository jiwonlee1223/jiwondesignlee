---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { t } from '@/i18n/utils';
import { accentBg, accentFg, typeLabel } from '@/lib/utils';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((entry) => ({
    params: { slug: entry.slug },
    props:  { entry },
  }));
}

const { entry } = Astro.props;
const {
  title, year, type, tags, summary, accent, cover,
  abstract, gallery,
  role, collaborators, venue, award, links,
} = entry.data;

// MDX 본문은 옵션 — 보통 비어 있음. 있다면 갤러리 아래에 가볍게 렌더.
const { Content } = await render(entry);

const bg = accentBg[accent];
const fg = accentFg[accent];

// 메타 사이드바 — 값이 있는 항목만
const metaItems = [
  { label: t('projects.year'),   value: String(year) },
  { label: t('projects.role'),   value: role          ?? null },
  { label: t('projects.collab'), value: collaborators ?? null },
  { label: t('projects.venue'),  value: venue         ?? null },
  { label: t('projects.award'),  value: award         ?? null },
].filter((item): item is { label: string; value: string } => item.value !== null);

const linkItems = [
  { label: t('project.paper'),  href: links?.paper  },
  { label: t('project.github'), href: links?.github },
  { label: t('project.demo'),   href: links?.demo   },
].filter((l): l is { label: string; href: string } => Boolean(l.href));

// prev / next 내비게이션
const allProjects = (await getCollection('projects'))
  .sort((a, b) => b.data.year - a.data.year);
const currentIdx = allProjects.findIndex((p) => p.slug === entry.slug);
const prev = allProjects[currentIdx + 1];
const next = allProjects[currentIdx - 1];
---

<BaseLayout title={`${title} — Jiwon`} description={summary}>
  <!-- ── 컴팩트 헤더: 메타 위주, 텍스트는 최소 ──────────────────────────── -->
  <header class={`${bg} ${fg}`}>
    <div class="site-container py-12 md:py-16">
      <a
        href="/"
        class="font-mono text-xs opacity-60 hover:opacity-100 transition-opacity mb-8 inline-block"
      >
        {t('project.backToAll')}
      </a>

      <div class="flex flex-wrap gap-4 font-mono text-xs opacity-60 uppercase tracking-widest mb-4">
        <span>{year}</span>
        <span>{typeLabel[type]}</span>
        {tags.map((tag) => <span>{tag}</span>)}
      </div>

      <h1 class="font-display font-bold text-display-lg max-w-4xl leading-tight">
        {title}
      </h1>
    </div>
  </header>

  <!-- ── 커버 이미지 — 페이지의 시각적 앵커 ─────────────────────────────── -->
  {cover && (
    <figure class="bg-fg/5">
      <Image
        src={cover}
        alt={`${title} — cover`}
        class="w-full max-h-[80vh] object-cover"
        widths={[640, 1024, 1440, 1920]}
        sizes="100vw"
      />
    </figure>
  )}

  <!-- ── 메타 + (있을 경우) abstract ────────────────────────────────────── -->
  <section class="site-container py-16 grid md:grid-cols-[1fr_260px] gap-12 items-start">
    <!-- 좌: 논문이 있으면 abstract만, 없으면 summary 한 줄 -->
    <div class="max-w-2xl">
      {abstract ? (
        <>
          <p class="font-mono text-xs text-fg-muted uppercase tracking-wider mb-3">
            {t('project.abstract')}
          </p>
          <p class="text-lg leading-relaxed text-fg">
            {abstract}
          </p>
        </>
      ) : (
        <p class="text-lg leading-relaxed text-fg-muted">
          {summary}
        </p>
      )}
    </div>

    <!-- 우: 메타 사이드바 -->
    <aside class="border-l border-fg/15 pl-6 space-y-6 md:sticky md:top-20">
      {metaItems.map(({ label, value }) => (
        <div>
          <dt class="font-mono text-xs text-fg-muted uppercase tracking-wider mb-1">
            {label}
          </dt>
          <dd class="text-sm font-medium">{value}</dd>
        </div>
      ))}

      {linkItems.length > 0 && (
        <div class="pt-4 border-t border-fg/10 space-y-2">
          <p class="font-mono text-xs text-fg-muted uppercase tracking-wider mb-3">
            {t('project.links')}
          </p>
          {linkItems.map(({ label, href }) => (
            <a
              href={href}
              target="_blank"
              rel="noopener noreferrer"
              class="block text-sm font-medium hover:text-accent-cobalt transition-colors"
            >
              {label} ↗
            </a>
          ))}
        </div>
      )}
    </aside>
  </section>

  <!-- ── 이미지 갤러리 — 메인 콘텐츠 ─────────────────────────────────────── -->
  {gallery && gallery.length > 0 && (
    <section class="site-container pb-20">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {gallery.map((item) => (
          <figure class={item.width === 'full' ? 'md:col-span-2' : 'md:col-span-1'}>
            <Image
              src={item.src}
              alt={item.alt}
              class="w-full h-auto bg-fg/5"
              widths={item.width === 'full' ? [640, 1024, 1440, 1920] : [400, 640, 960]}
              sizes={
                item.width === 'full'
                  ? '(max-width: 768px) 100vw, 1200px'
                  : '(max-width: 768px) 100vw, 600px'
              }
            />
            {item.caption && (
              <figcaption class="mt-3 font-mono text-xs text-fg-muted">
                {item.caption}
              </figcaption>
            )}
          </figure>
        ))}
      </div>
    </section>
  )}

  <!-- ── 선택적 MDX 본문 — 비어있으면 렌더되지 않음 ────────────────────── -->
  <article class="site-container pb-20 prose prose-lg max-w-3xl
    prose-headings:font-display prose-headings:font-bold
    prose-a:text-accent-cobalt prose-a:no-underline hover:prose-a:underline
    prose-img:rounded-none">
    <Content />
  </article>

  <!-- ── prev / next 내비게이션 ────────────────────────────────────────── -->
  <nav
    aria-label="Project navigation"
    class="site-container border-t border-fg/10 py-10 flex justify-between gap-8 text-sm"
  >
    {prev ? (
      <a
        href={`/projects/${prev.slug}/`}
        class="group flex flex-col gap-1 max-w-[45%]"
      >
        <span class="font-mono text-xs text-fg-muted">← {t('project.prev')}</span>
        <span class="font-medium group-hover:text-accent-cobalt transition-colors line-clamp-1">
          {prev.data.title}
        </span>
      </a>
    ) : <span />}

    {next && (
      <a
        href={`/projects/${next.slug}/`}
        class="group flex flex-col gap-1 max-w-[45%] text-right ml-auto"
      >
        <span class="font-mono text-xs text-fg-muted">{t('project.next')} →</span>
        <span class="font-medium group-hover:text-accent-cobalt transition-colors line-clamp-1">
          {next.data.title}
        </span>
      </a>
    )}
  </nav>
</BaseLayout>
