---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { t } from '@/i18n/utils';
import { accentBg, accentFg, typeLabel } from '@/lib/utils';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((entry) => ({
    params: { slug: entry.id },
    props:  { entry },
  }));
}

const { entry } = Astro.props;
const {
  title, year, type, tags, summary, accent, cover,
  abstract, gallery, priorWork, journey,
  confidential, role, authors, collaborators, advisor, venue, support, award, links,
} = entry.data;

// 여정 단계별 점 색상
const journeyAccent = {
  'design-practice':    'mustard',
  'design-research':    'lavender',
  'design-exploration': 'lime',
} as const;

const bg = accentBg[accent];
const fg = accentFg[accent];

// 메타 사이드바: 값이 있는 항목만
const metaItems = [
  { label: t('projects.year'),   value: String(year) },
  { label: t('projects.role'),   value: role          ?? null },
  { label: t('projects.authors'), value: authors       ?? null },
  { label: t('projects.collab'), value: collaborators ?? null },
  { label: t('projects.advisor'), value: advisor      ?? null },
  { label: t('projects.venue'),  value: venue         ?? null },
  { label: t('projects.support'), value: support       ?? null },
  { label: t('projects.award'), value: award         ?? null },
].filter((item): item is { label: string; value: string } => item.value !== null);

const linkItems = [
  { label: t('project.paper'),  href: links?.paper  },
  { label: t('project.github'), href: links?.github },
  { label: t('project.demo'),   href: links?.demo   },
].filter((l): l is { label: string; href: string } => Boolean(l.href));

// prev / next 내비게이션
const allProjects = (await getCollection('projects'))
  .sort((a, b) => b.data.year - a.data.year);
const currentIdx = allProjects.findIndex((p) => p.id === entry.id);
const prev = allProjects[currentIdx + 1];
const next = allProjects[currentIdx - 1];
---

<BaseLayout title={`${title} | Jiwon`} description={summary}>
  <!-- ── 상단: 뒤로가기 → 제목/메타 → 커버 이미지(화면 폭 전체) ───────── -->
  <div class="site-container pt-6 md:pt-8">
    <a
      href="/"
      class="font-mono text-xs text-fg-muted hover:text-fg transition-colors inline-block py-2"
    >
      {t('project.backToAll')}
    </a>
  </div>

  <header class="site-container pt-4 md:pt-6">
    <div class="flex flex-wrap items-center gap-x-4 gap-y-1 font-mono text-xs text-fg-muted uppercase tracking-widest mb-4">
      <span class={`inline-block w-2.5 h-2.5 rounded-full ${bg}`} aria-hidden="true"></span>
      <span>{year}</span>
      <span>{typeLabel[type]}</span>
    </div>

    <h1 class="font-display font-bold text-display-lg max-w-4xl leading-tight text-fg">
      {title}
    </h1>

    {tags.length > 0 && (
      <ul class="flex flex-wrap gap-2 mt-6" role="list" aria-label="Tags">
        {tags.map((tag) => (
          <li class="px-3 py-1.5 rounded-full border border-fg/20 text-xs leading-none text-fg-muted">
            {tag}
          </li>
        ))}
      </ul>
    )}
  </header>

  <figure class="mt-8 md:mt-10">
    {cover ? (
      <div class="relative w-full aspect-[4/3] md:aspect-[16/9] max-h-[85vh] overflow-hidden bg-fg/5">
        <Image
          src={cover}
          alt={`${title} cover`}
          class="absolute inset-0 w-full h-full object-cover"
          widths={[640, 1024, 1440, 1920, 2560]}
          sizes="100vw"
          loading="eager"
        />
      </div>
    ) : (
      <div
        class={`${bg} ${fg} w-full aspect-[4/3] md:aspect-[16/9] max-h-[85vh] flex items-end p-6 md:p-10`}
        aria-hidden="true"
      >
        <span class="font-display font-bold text-display-md leading-tight opacity-50 max-w-3xl">
          {title}
        </span>
      </div>
    )}
  </figure>

  <!-- ── 메타 + (있을 경우) abstract ────────────────────────────────────── -->
  <section class="site-container py-10 md:py-14 grid md:grid-cols-[1fr_260px] gap-10 md:gap-12 items-start">
    <!-- 좌: 논문이 있으면 abstract만, 없으면 summary 한 줄 -->
    <div class="max-w-2xl">
      {journey && journey.length > 0 && (
        <div class="mb-10 md:mb-12">
          <p class="font-mono text-xs text-fg-muted uppercase tracking-wider mb-4">
            {t('project.journey')}
          </p>
          <ol class="space-y-3">
            {journey.map((step) => (
              <li class="flex items-baseline gap-3">
                <span class={`inline-block w-2.5 h-2.5 rounded-full shrink-0 ${accentBg[journeyAccent[step.type]]}`} aria-hidden="true"></span>
                <div class="flex flex-wrap sm:flex-nowrap items-baseline gap-x-3 gap-y-1 min-w-0">
                  <span class="font-mono text-xs text-fg-muted uppercase tracking-wider sm:w-44 sm:shrink-0">
                    {typeLabel[step.type]}
                  </span>
                  <span class="font-mono text-xs text-fg-muted sm:w-10 sm:shrink-0">{step.year}</span>
                  <span class="text-sm text-fg w-full sm:w-auto">{step.label}</span>
                </div>
              </li>
            ))}
          </ol>
        </div>
      )}

      {abstract ? (
        <>
          <p class="font-mono text-xs text-fg-muted uppercase tracking-wider mb-3">
            {t('project.abstract')}
          </p>
          <p class="text-lg leading-relaxed text-fg">
            {abstract}
          </p>
        </>
      ) : confidential ? null : (
        <p class="text-lg leading-relaxed text-fg-muted">
          {summary}
        </p>
      )}

      {confidential && (
        <p class="font-mono text-xs text-fg-muted">
          {t('project.confidential')}
        </p>
      )}

      {priorWork && (
        <div class="mt-12 pt-8 border-t border-fg/10">
          <p class="font-mono text-xs text-fg-muted uppercase tracking-wider mb-3">
            {t('project.priorWork')}
          </p>
          <h2 class="font-display font-medium text-xl leading-snug text-fg">
            {priorWork.paper ? (
              <a href={priorWork.paper} target="_blank" rel="noopener noreferrer"
                 class="hover:text-accent-cobalt transition-colors duration-200">
                {priorWork.title}
              </a>
            ) : priorWork.title}
          </h2>
          {(priorWork.venue || priorWork.year) && (
            <p class="mt-2 font-mono text-xs text-fg-muted uppercase tracking-wider">
              {[priorWork.venue, priorWork.year].filter(Boolean).join(' · ')}
            </p>
          )}
          {priorWork.abstract && (
            <p class="mt-4 text-base leading-relaxed text-fg-muted">
              {priorWork.abstract}
            </p>
          )}
        </div>
      )}
    </div>

    <!-- 우: 메타 사이드바 -->
    <aside class="border-t md:border-t-0 md:border-l border-fg/15 pt-8 md:pt-0 md:pl-6 space-y-6 md:sticky md:top-20">
      {metaItems.map(({ label, value }) => (
        <div>
          <dt class="font-mono text-xs text-fg-muted uppercase tracking-wider mb-1">
            {label}
          </dt>
          <dd class="text-sm font-medium whitespace-pre-line">{value}</dd>
        </div>
      ))}

      {linkItems.length > 0 && (
        <div class="pt-4 border-t border-fg/10 space-y-2">
          <p class="font-mono text-xs text-fg-muted uppercase tracking-wider mb-3">
            {t('project.links')}
          </p>
          {linkItems.map(({ label, href }) => (
            <a
              href={href}
              target="_blank"
              rel="noopener noreferrer"
              class="block text-sm font-medium hover:text-accent-cobalt transition-colors"
            >
              {label} ↗
            </a>
          ))}
        </div>
      )}
    </aside>
  </section>

  <!-- ── 이미지 갤러리: 메인 콘텐츠 ─────────────────────────────────────── -->
  {gallery && gallery.length > 0 && (
    <section class="site-container pb-12 md:pb-20">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {gallery.map((item) => (
          <figure class={item.width === 'full' ? 'md:col-span-2' : 'md:col-span-1'}>
            <Image
              src={item.src}
              alt={item.alt}
              class="w-full h-auto bg-fg/5"
              widths={item.width === 'full' ? [640, 1024, 1440, 1920] : [400, 640, 960]}
              sizes={
                item.width === 'full'
                  ? '(max-width: 768px) 100vw, 1200px'
                  : '(max-width: 768px) 100vw, 600px'
              }
            />
            {item.caption && (
              <figcaption class="mt-3 font-mono text-xs text-fg-muted">
                {item.caption}
              </figcaption>
            )}
          </figure>
        ))}
      </div>
    </section>
  )}

  <!-- ── prev / next 내비게이션 ────────────────────────────────────────── -->
  <nav
    aria-label="Project navigation"
    class="site-container border-t border-fg/10 py-8 md:py-10 flex justify-between gap-4 md:gap-8 text-sm"
  >
    {prev ? (
      <a
        href={`/projects/${prev.id}/`}
        class="group flex flex-col gap-1 max-w-[45%]"
      >
        <span class="font-mono text-xs text-fg-muted">← {t('project.prev')}</span>
        <span class="font-medium group-hover:text-accent-cobalt transition-colors line-clamp-1">
          {prev.data.title}
        </span>
      </a>
    ) : <span />}

    {next && (
      <a
        href={`/projects/${next.id}/`}
        class="group flex flex-col gap-1 max-w-[45%] text-right ml-auto"
      >
        <span class="font-mono text-xs text-fg-muted">{t('project.next')} →</span>
        <span class="font-medium group-hover:text-accent-cobalt transition-colors line-clamp-1">
          {next.data.title}
        </span>
      </a>
    )}
  </nav>
</BaseLayout>
