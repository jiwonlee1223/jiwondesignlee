---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { accentBg, accentFg, typeLabel } from '@/lib/utils';

interface Props {
  entry: CollectionEntry<'projects'>;
}

const { entry } = Astro.props;
const { title, year, type, accent, cover, venue, award } = entry.data;
const href = `/projects/${entry.slug}/`;
---

<a
  href={href}
  class="group flex flex-col focus:outline-none focus-visible:ring-2 focus-visible:ring-fg"
>
  <!-- 이미지 영역 — cover 있으면 이미지, 없으면 accent 컬러 블록 (폴백) -->
  <div class="relative aspect-[4/3] overflow-hidden bg-fg/5">
    {cover ? (
      <Image
        src={cover}
        alt={`${title} — cover`}
        class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.03]"
        widths={[400, 640, 960, 1280]}
        sizes="(max-width: 768px) 100vw, (max-width: 1024px) 50vw, 33vw"
      />
    ) : (
      <div
        class={`absolute inset-0 ${accentBg[accent]} ${accentFg[accent]}
                flex items-end p-6 transition-opacity duration-300 group-hover:opacity-90`}
        aria-hidden="true"
      >
        <span class="font-display font-bold text-2xl leading-tight opacity-50">
          {title}
        </span>
      </div>
    )}
  </div>

  <!-- 메타 + 제목 — 텍스트는 최소 -->
  <div class="pt-4">
    <div class="flex flex-wrap items-center gap-3 font-mono text-xs text-fg-muted uppercase tracking-wider">
      <span>{year}</span>
      <span>{typeLabel[type]}</span>
      {venue && <span>{venue}</span>}
    </div>

    <h3 class="mt-2 font-display font-medium text-lg leading-snug text-fg
               group-hover:text-accent-cobalt transition-colors duration-200">
      {title}
    </h3>

    {award && (
      <p class="mt-2 font-mono text-[11px] text-accent-vermilion">
        ★ {award}
      </p>
    )}
  </div>
</a>
