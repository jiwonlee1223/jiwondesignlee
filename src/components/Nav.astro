---
import { t } from '@/i18n/utils';

// 홈(/) 자체가 프로젝트 갤러리 + 카테고리 삼각형을 포함하는 단일 진입점이라
// 별도 'Projects' 항목은 두지 않는다. /projects/ 는 / 로 redirect.
const navLinks = [
  { href: '/',       label: t('nav.home') },
  { href: '/about/', label: t('nav.about') },
];

const current = Astro.url.pathname;
---

<header class="border-b border-fg/10 bg-bg sticky top-0 z-50">
  <nav
    class="site-container flex items-center justify-between h-14"
    aria-label="Main navigation"
  >
    <!-- 로고 (JW 모노그램) — 홈으로 이동 -->
    <a href="/" class="flex items-center" aria-label="Jiwon — home">
      <img
        src="/logo.png"
        alt="Jiwon"
        width="28"
        height="28"
        class="h-7 w-7 object-contain"
      />
    </a>

    <!-- 링크 목록 -->
    <ul class="hidden md:flex items-center gap-6 text-sm" role="list">
      {navLinks.map(({ href, label }) => (
        <li>
          <a
            href={href}
            aria-current={current === href ? 'page' : undefined}
            class="text-fg-muted hover:text-fg transition-colors aria-[current=page]:text-fg aria-[current=page]:font-medium"
          >
            {label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>
